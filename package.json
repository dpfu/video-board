{
  "name": "video-board",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "license": "(MIT AND LGPL-2.1-or-later)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5193 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "1.46.0",
    "mediabunny": "1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.10.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
  }
}
